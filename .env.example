# Barchasi ixtiyoriy (application.yml dagi standart qiymatlar ishlaydi). IntelliJ: Run configuration → Environment variables.
PORT=3001

# --- PostgreSQL (production) ---
DB_URL=jdbc:postgresql://localhost:5432/ant
DB_USER=ant
DB_PASSWORD=ant

# --- Birinchi ishga tushirishda yaratiladigan Super admin ---
ADMIN_USER=admin
# Bo'sh bo'lsa: admin123 (ogohlantirish chiqadi) — admin paneldan darhol almashtiring!
ADMIN_PASSWORD=

# Yuklangan rasm/video papkasi (uploads/) — zaxiralang! Standart: ./data
DATA_DIR=
# Production'da shu papkadagi build qilingan sayt ham beriladi (ant-frontend/dist)
FRONTEND_DIST=../ant-frontend/dist

# Eski Node versiyasi ma'lumotini bo'sh bazaga bir marta ko'chirish: db.json yo'li
IMPORT_JSON=

TIMEZONE=Asia/Tashkent
RATE_LIMIT=true
TRUST_PROXY=true
# Swagger UI (/api/docs): productionda false qiling
DOCS_ENABLED=true
